{#
| Variable                     | Type     | Description                                |
|------------------------------|----------|--------------------------------------------|
| component                    | object   | Merchant settings                          |
| component.title              | ?string  | Section title                              |
| component.links              | object[] | list of quick menu links                   |
| component.links[].icon       | string   | sicon-* class                              |
| component.links[].image      | string   | category photo url                         |
| component.links[].title      | string   |                                            |
| component.links[].url        | string   | resolved variable-list url                 |
| position                     | int      | Sorting number start from zero             |
#}
<section data-testid="store-home-menu-links" class="s-block s-block--quick-menu category-section">
    <div class="container">
        {% if component.title %}
            <div class="section-title category-heading">
                <div>
                    <span>{{ trans('blocks.sufra.categories_eyebrow') }}</span>
                    <h2>{{ component.title }}</h2>
                </div>
                <p>{{ trans('blocks.sufra.categories_desc') }}</p>
            </div>
        {% endif %}
        <div class="category-grid">
            {% for link in component.links %}
                {% if link.title %}
                    <a href="{{ link.url }}" class="category-card">
                        <span class="category-card__media">
                            {% if link.image %}
                                <img src="{{ link.image }}" alt="{{ link.title }}" loading="lazy">
                            {% else %}
                                <span class="category-card__fallback"><i class="{{ link.icon ?: 'sicon-store2' }}"></i></span>
                            {% endif %}
                        </span>
                        <span class="category-card__body">
                            <span>
                                {% if link.icon %}<small><i class="{{ link.icon }}"></i></small>{% endif %}
                                <strong>{{ link.title }}</strong>
                            </span>
                            <span class="category-card__arrow" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                            </span>
                        </span>
                    </a>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>
